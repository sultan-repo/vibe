{
  "description": "Vibe: the owner's standing preferences and the project's saved status note at session start, and a keep-list for compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules.md\"" },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" status.py", "timeout": 10 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/keep.txt\"" }]
      }
    ]
  }
}
